# PostgreSQL connectiestring
DATABASE_URL="postgresql://user:password@localhost:5432/crm?schema=public"

# NextAuth / Auth.js
# Genereer met: npx auth secret   (of: openssl rand -base64 32)
AUTH_SECRET=""
# Basis-URL van de app, nodig voor redirects (login, Google OAuth callback)
NEXTAUTH_URL="http://localhost:3000"

# Google Cloud OAuth client (Google Cloud Console > APIs & Services > Credentials)
# Voeg beide redirect-URI's hieronder toe als "Authorized redirect URI" bij
# dezelfde client (Calendar en Sheets-back-up gebruiken elk hun eigen route).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"
GOOGLE_SHEETS_REDIRECT_URI="http://localhost:3000/api/google-sheets-backup/callback"

# Versleutelt opgeslagen Google Calendar/Sheets refresh tokens in de database.
# Genereer met: openssl rand -base64 32
# Zonder deze variabele blijven tokens (voorlopig) onversleuteld opgeslagen.
TOKEN_ENCRYPTION_KEY=""

# Beveiligt de nachtelijke cron-endpoint (/api/cron/sheets-backup) tegen
# publieke aanroepen. Vercel stuurt deze automatisch mee als "Authorization:
# Bearer <CRON_SECRET>" bij een cron-invocatie zodra deze env var ingesteld
# staat op het project. Genereer met: openssl rand -base64 32
CRON_SECRET=""
