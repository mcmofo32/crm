# PostgreSQL connectiestring
DATABASE_URL="postgresql://user:password@localhost:5432/crm?schema=public"

# NextAuth / Auth.js
# Genereer met: npx auth secret   (of: openssl rand -base64 32)
AUTH_SECRET=""
# Basis-URL van de app, nodig voor redirects (login, Google OAuth callback)
NEXTAUTH_URL="http://localhost:3000"

# Google Cloud OAuth client (Google Cloud Console > APIs & Services > Credentials)
# Dezelfde client wordt voor 3 dingen gebruikt — voeg alle 3 redirect-URI's
# hieronder toe als "Authorized redirect URI" bij die ene client:
#   1. Inloggen in het CRM zelf (NextAuth "Sign in with Google"):
#      http://localhost:3000/api/auth/callback/google
#   2. Google Agenda-koppeling per gebruiker: GOOGLE_REDIRECT_URI hieronder
#   3. Google Sheets-back-up: GOOGLE_SHEETS_REDIRECT_URI hieronder
# Inloggen is enkel toegestaan voor Google-accounts waarvan het e-mailadres
# al bestaat als actieve gebruiker in het CRM (zie Gebruikers) — de client
# zelf hoeft dus niet beperkt te worden tot een bepaald Workspace-domein.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"
GOOGLE_SHEETS_REDIRECT_URI="http://localhost:3000/api/google-sheets-backup/callback"

# Versleutelt opgeslagen Google Calendar/Sheets refresh tokens in de database.
# Genereer met: openssl rand -base64 32
# Zonder deze variabele blijven tokens (voorlopig) onversleuteld opgeslagen.
TOKEN_ENCRYPTION_KEY=""

# Beveiligt de nachtelijke cron-endpoint (/api/cron/sheets-backup) tegen
# publieke aanroepen. Vercel stuurt deze automatisch mee als "Authorization:
# Bearer <CRON_SECRET>" bij een cron-invocatie zodra deze env var ingesteld
# staat op het project. Genereer met: openssl rand -base64 32
CRON_SECRET=""

# Bestandsopslag voor de Bibliotheek-pagina (Vercel Blob). Zet "Storage" >
# "Create Database" > "Blob" aan op het Vercel-project — deze variabele
# verschijnt dan automatisch, zelf niets in te vullen.
BLOB_READ_WRITE_TOKEN=""
