// Prisma schema for the CRM
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Access control
// ---------------------------------------------------------------------------

/// Beheerder  = alle rechten (volledige systeembeheerder)
/// Admin      = veel rechten (beheert leads/gebruikers, geen systeeminstellingen)
/// Coach      = toegang tot zichzelf + zijn team
/// User       = toegang enkel tot zichzelf
enum Role {
  BEHEERDER
  ADMIN
  COACH
  USER
}

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// De coach die dit team leidt
  coachId String @unique
  coach   User   @relation("TeamCoach", fields: [coachId], references: [id])

  /// De teamleden (rol USER) die aan deze coach rapporteren
  members User[] @relation("TeamMembers")

  subagents Subagent[]
}

/// Subagent: sluit adviesgesprekken mee af, geen inlogaccount (enkel contactgegevens).
model Subagent {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  activities Activity[] @relation("ActivitySubagent")

  @@index([teamId])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  phone        String?
  passwordHash String
  role         Role     @default(USER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Team waarvan deze gebruiker lid is (enkel relevant voor rol USER)
  teamId String?
  team   Team?   @relation("TeamMembers", fields: [teamId], references: [id])

  /// Team dat deze gebruiker als coach leidt (enkel relevant voor rol COACH)
  coachedTeam Team? @relation("TeamCoach")

  // Google Calendar koppeling (per gebruiker) voor het automatisch inplannen
  // van gesprekken. De refresh token laat de app toe om zonder herhaalde
  // login een agenda-item aan te maken.
  googleCalendarConnected    Boolean @default(false)
  googleCalendarRefreshToken String?
  googleCalendarId           String? @default("primary")
  googleCalendarEmail        String?

  /// Eigen Zoom-link, gebruikt in online-afspraken die deze gebruiker inplant
  zoomLink String?

  leadsOwned        Lead[]            @relation("LeadOwner")
  leadsCreated      Lead[]            @relation("LeadCreatedBy")
  leadsDeleted      Lead[]            @relation("LeadDeletedBy")
  activities        Activity[]        @relation("ActivityAssignee")
  stageChanges      LeadStageChange[] @relation("StageChangedBy")
  incentivesCreated Incentive[]       @relation("IncentiveCreatedBy")
  auditLogEntries   AuditLog[]        @relation("AuditActor")

  goals             UserGoal[]            @relation("UserGoals")
  kpiGoals          UserKpiGoal[]         @relation("UserKpiGoals")
  kpiMonthlyEntries UserKpiMonthlyEntry[] @relation("UserKpiMonthlyEntries")

  @@index([teamId])
}

/// Logboek van belangrijke beheersacties, enkel zichtbaar voor de Beheerder.
model AuditLog {
  id          String   @id @default(cuid())
  /// Machine-leesbare actie, bv. "lead.deleted", "user.role_changed"
  action      String
  entityType  String
  entityId    String
  description String
  actorId     String
  actor       User     @relation("AuditActor", fields: [actorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Leads & funnels
// ---------------------------------------------------------------------------

/// De twee productlijnen/funnels die momenteel bestaan.
/// FA = Financiële Analyse / Financieel Advies
/// RG = Rechtsbijstand/Groep
enum LeadType {
  FA
  RG
}

enum LeadStatus {
  OPEN
  WON
  LOST
}

/// Configureerbare kolommen van de funnel-boards, per leadtype.
model FunnelStage {
  id        String   @id @default(cuid())
  leadType  LeadType
  key       String
  label     String
  order     Int
  color     String   @default("#64748b")
  isWon     Boolean  @default(false)
  isLost    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads            Lead[]
  stageChangesFrom LeadStageChange[] @relation("FromStage")
  stageChangesTo   LeadStageChange[] @relation("ToStage")

  @@unique([leadType, key])
  @@index([leadType, order])
}

model Lead {
  id              String     @id @default(cuid())
  firstName       String
  lastName        String
  email           String?
  phone           String?
  company         String?
  leadType        LeadType
  status          LeadStatus @default(OPEN)
  source          String?
  notes           String?
  value           Decimal?   @db.Decimal(10, 2)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  lastContactedAt DateTime?

  stageId String
  stage   FunnelStage @relation(fields: [stageId], references: [id])

  /// De verantwoordelijke medewerker (bepaalt zichtbaarheid via rollen)
  ownerId String
  owner   User   @relation("LeadOwner", fields: [ownerId], references: [id])

  createdById String
  createdBy   User   @relation("LeadCreatedBy", fields: [createdById], references: [id])

  /// Soft delete: verwijderde leads komen in de prullenbak i.p.v. definitief weg te zijn.
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("LeadDeletedBy", fields: [deletedById], references: [id])

  activities   Activity[]
  stageChanges LeadStageChange[]
  products     LeadProduct[]

  @@index([ownerId])
  @@index([leadType, stageId])
  @@index([deletedAt])
}

/// De financiële producten die Ceuppens Consulting aanbiedt, gekoppeld aan een klant.
enum ProductType {
  PENSIOENSPAREN
  LANGETERMIJNSPAREN
  BELEGGEN
  DELA
  VAPZ
  IPT
  KINDERSPAREN
}

/// Eén product dat een klant genomen heeft (bedrag + aantal eenheden), ingevuld
/// bij het rapporteren wanneer een lead klant wordt. Gebruikt voor het
/// klantenoverzicht en voor de "aantal eenheden"-categorie bij incentives.
model LeadProduct {
  id        String      @id @default(cuid())
  leadId    String
  lead      Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      ProductType
  amount    Decimal     @db.Decimal(10, 2)
  units     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([leadId])
}

model LeadStageChange {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  fromStageId String?
  fromStage   FunnelStage? @relation("FromStage", fields: [fromStageId], references: [id])

  toStageId String
  toStage   FunnelStage @relation("ToStage", fields: [toStageId], references: [id])

  changedById String
  changedBy   User   @relation("StageChangedBy", fields: [changedById], references: [id])

  changedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Opvolging: activiteiten & ingeplande gesprekken
// ---------------------------------------------------------------------------

enum ActivityType {
  CALL
  MEETING
  EMAIL
  NOTE
}

enum ActivityStatus {
  PLANNED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum MeetingMode {
  ONSITE
  ONLINE
}

model Activity {
  id              String         @id @default(cuid())
  type            ActivityType
  status          ActivityStatus @default(PLANNED)
  subject         String
  notes           String?
  scheduledAt     DateTime?
  durationMinutes Int?           @default(15)
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  assigneeId String
  assignee   User   @relation("ActivityAssignee", fields: [assigneeId], references: [id])

  // Koppeling met het Google Calendar event zodat we het later kunnen
  // updaten/verwijderen wanneer de activiteit verandert.
  googleEventId    String?
  googleCalendarId String?
  googleSyncError  String?

  // Planning-widget: locatie/online-gegevens voor een ingeplande afspraak
  // (Financiële analyse/Adviesgesprek e.d.), meegenomen in het Google
  // Agenda-item als locatie/omschrijving/Meet-koppeling.
  meetingMode MeetingMode?
  location    String?
  meetingLink String?

  /// Subagent die mee uitgenodigd wordt (bv. bij een Adviesgesprek, om te closen).
  subagentId String?
  subagent   Subagent? @relation("ActivitySubagent", fields: [subagentId], references: [id])

  @@index([leadId])
  @@index([assigneeId])
  @@index([scheduledAt])
}

// ---------------------------------------------------------------------------
// Incentives: motivatie-events met een doel, poster en ranglijst
// ---------------------------------------------------------------------------

/// Op welke meting een categorie of top-N-ranglijst gebaseerd is.
enum IncentiveMetric {
  /// Aantal leads dat een gebruiker heeft gewonnen (klanten) binnen de looptijd
  CLIENTS_WON
  /// Som van het aantal eenheden van gewonnen leads binnen de looptijd
  UNITS
  /// Aantal afgeronde RG-gesprekken binnen de looptijd
  RG_MEETINGS
  /// Aantal afgeronde contactmomenten/activiteiten binnen de looptijd
  ACTIVITIES_COMPLETED
}

/// Hoe winnaars bepaald worden: op richtcijfers per categorie, of gewoon top-N.
enum IncentiveMode {
  /// Elke categorie heeft een richtcijfer (bv. min 5 klanten); wie alle richtcijfers haalt wint
  THRESHOLD
  /// Geen richtcijfer: de top N op de ranglijst wint
  TOP_N
}

model Incentive {
  id          String        @id @default(cuid())
  title       String
  /// De regels/vereisten om te winnen, vrije tekst
  description String
  mode        IncentiveMode @default(THRESHOLD)

  /// Enkel bij mode = TOP_N: op welke meting wordt gerangschikt
  rankingMetric   IncentiveMetric?
  /// Enkel bij mode = TOP_N: optioneel enkel leads van dit type meetellen
  rankingLeadType LeadType?
  /// Enkel bij mode = TOP_N: hoeveel plaatsen winnen (top 1 t.e.m. top 10)
  topN            Int?

  startDate DateTime
  endDate   DateTime

  // De poster (jpeg of pdf) wordt als binaire data in de database bewaard,
  // zodat er geen aparte bestandsopslag nodig is.
  posterData     Bytes?
  posterMimeType String?
  posterFilename String?

  createdById String
  createdBy   User     @relation("IncentiveCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories IncentiveCategory[]

  @@index([startDate, endDate])
}

/// Enkel bij mode = THRESHOLD: één rij per categorie met een eigen richtcijfer
/// (bv. "min 5 klanten", "min 800 eenheden", "min 1 RG-gesprek").
model IncentiveCategory {
  id          String          @id @default(cuid())
  incentiveId String
  incentive   Incentive       @relation(fields: [incentiveId], references: [id], onDelete: Cascade)
  metric      IncentiveMetric
  /// Optioneel: enkel leads van dit type meetellen voor deze categorie (null = FA + RG samen)
  leadType    LeadType?
  targetValue Int
  order       Int             @default(0)

  @@index([incentiveId])
}

// ---------------------------------------------------------------------------
// Doelen / KPI's per gebruiker (dashboard-management)
// ---------------------------------------------------------------------------

/// De wekelijkse doelen bovenaan het dashboard.
enum GoalMetric {
  UNITS
  CUSTOMERS
  CONVERSATIONS
  ABV_SALES
  ABV_RG
}

/// Eén wekelijks doel per gebruiker per metric, ingesteld door een Beheerder/Admin.
/// Het `target` geldt vanaf het moment van instellen (geen historiek per week).
model UserGoal {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation("UserGoals", fields: [userId], references: [id], onDelete: Cascade)
  metric    GoalMetric
  target    Decimal    @db.Decimal(12, 2)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, metric])
}

/// De 4 jaarlijkse KPI's onder "Productie jaarlijks".
enum KpiMetric {
  CONVERSATIONS
  PRODUCTION
  CALLING_SESSION
  SEMINAR
}

/// Jaarlijks doel per gebruiker per KPI (per jaar apart in te stellen).
model UserKpiGoal {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("UserKpiGoals", fields: [userId], references: [id], onDelete: Cascade)
  metric    KpiMetric
  year      Int
  target    Decimal   @db.Decimal(12, 2)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, metric, year])
}

/// Manueel ingevoerde maandstand per KPI; de som van de 12 maanden vormt het jaarcijfer.
model UserKpiMonthlyEntry {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("UserKpiMonthlyEntries", fields: [userId], references: [id], onDelete: Cascade)
  metric    KpiMetric
  year      Int
  /// 1 (januari) t.e.m. 12 (december)
  month     Int
  value     Decimal   @db.Decimal(12, 2)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, metric, year, month])
  @@index([userId, metric, year])
}
