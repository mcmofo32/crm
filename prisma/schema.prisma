// Prisma schema for the CRM
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Access control
// ---------------------------------------------------------------------------

/// Beheerder  = alle rechten (volledige systeembeheerder)
/// Admin      = veel rechten (beheert leads/gebruikers, geen systeeminstellingen)
/// Coach      = toegang tot zichzelf + zijn team
/// User       = toegang enkel tot zichzelf
enum Role {
  BEHEERDER
  ADMIN
  COACH
  USER
}

/// Functie/graad van een gebruiker, getoond op het organigram.
enum JobFunction {
  FT1
  FT2
  FT3
  FTC
  FA
  FC
  DC
  RC
  NC
}

/// Analyst = standaard; Subagent = werkt onder het nummer van een andere agent.
enum AgentType {
  ANALYST
  SUBAGENT
}

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// De coach die dit team leidt
  coachId String @unique
  coach   User   @relation("TeamCoach", fields: [coachId], references: [id])

  /// De teamleden (rol USER) die aan deze coach rapporteren
  members User[] @relation("TeamMembers")

  subagents Subagent[]
}

/// Subagent: sluit adviesgesprekken mee af, geen inlogaccount (enkel contactgegevens).
model Subagent {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  /// Manueel toegevoegde subagenten staan hier altijd op true. Een
  /// automatisch gesynchroniseerde (zie userId) staat op false zodra de
  /// gekoppelde gebruiker niet langer kwalificeert (bv. Type niet meer
  /// Subagent, geen e-mail meer, inactief) — het record blijft dan bestaan
  /// voor de historiek van al gekoppelde activiteiten/leads, maar valt weg
  /// uit de kiesbare lijst.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  /// Gekoppelde gebruiker als deze vermelding automatisch gesynchroniseerd
  /// wordt vanuit iemands "Type: Subagent"-instelling (een echte
  /// medewerker met inlogaccount) i.p.v. manueel als los extern contact
  /// toegevoegd.
  userId String? @unique
  user   User?   @relation("SubagentForUser", fields: [userId], references: [id], onDelete: Cascade)

  activities       Activity[] @relation("ActivitySubagent")
  caseManagedLeads Lead[]     @relation("LeadCaseManagerSubagent")

  @@index([teamId])
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  role      Role     @default(USER)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Soft delete: het account zelf (en alle historiek die ernaar verwijst —
  /// activiteiten, audit log, ...) blijft bestaan, maar de gebruiker kan niet
  /// meer inloggen en verdwijnt uit alle keuzelijsten. Klanten/leads die deze
  /// gebruiker nog bezat, worden bij het verwijderen verplicht overgezet naar
  /// een andere gebruiker (zie deleteUserAction).
  deletedAt DateTime?

  /// Gezet door de Beheerder via "Sessie beëindigen" op het gebruikersprofiel:
  /// elke sessie die vóór dit tijdstip is ingelogd, wordt bij de
  /// eerstvolgende paginanavigatie als uitgelogd behandeld (zie
  /// getFreshSessionUser), ongeacht of het onderliggende sessie-token zelf
  /// nog geldig zou zijn.
  sessionInvalidatedAt DateTime?

  /// Team waarvan deze gebruiker lid is (enkel relevant voor rol USER)
  teamId String?
  team   Team?   @relation("TeamMembers", fields: [teamId], references: [id])

  /// Team dat deze gebruiker als coach leidt (enkel relevant voor rol COACH)
  coachedTeam Team? @relation("TeamCoach")

  /// Automatisch gesynchroniseerd Subagent-record als agentType SUBAGENT is
  /// (zie Subagent.userId) — laat deze gebruiker mee kiesbaar zijn bij het
  /// uitnodigen van een subagent op een adviesgesprek.
  subagentRecord Subagent? @relation("SubagentForUser")

  // Google Calendar koppeling (per gebruiker) voor het automatisch inplannen
  // van gesprekken. De refresh token laat de app toe om zonder herhaalde
  // login een agenda-item aan te maken.
  googleCalendarConnected    Boolean @default(false)
  googleCalendarRefreshToken String?
  googleCalendarId           String? @default("primary")
  googleCalendarEmail        String?

  /// Eigen Zoom-link, gebruikt in online-afspraken die deze gebruiker inplant
  zoomLink String?

  /// Functie/graad, getoond op het organigram.
  jobFunction JobFunction?

  // Profielfoto, als binaire data in de database bewaard (zelfde aanpak als
  // de Incentive-poster), zodat er geen aparte bestandsopslag nodig is.
  avatarData      Bytes?
  avatarMimeType  String?
  avatarUpdatedAt DateTime?

  /// Analyst (standaard) of subagent; subagenten krijgen een icoon op het organigram.
  agentType AgentType @default(ANALYST)

  leadsOwned        Lead[]            @relation("LeadOwner")
  leadsCreated      Lead[]            @relation("LeadCreatedBy")
  leadsDeleted      Lead[]            @relation("LeadDeletedBy")
  activities        Activity[]        @relation("ActivityAssignee")
  stageChanges      LeadStageChange[] @relation("StageChangedBy")
  incentivesCreated Incentive[]       @relation("IncentiveCreatedBy")
  auditLogEntries   AuditLog[]        @relation("AuditActor")
  loginEvents       LoginEvent[]      @relation("UserLoginEvents")
  dismissedDuplicateGroups DismissedDuplicateGroup[] @relation("DuplicateGroupDismissedBy")

  goals             UserGoal[]            @relation("UserGoals")
  monthlyGoals      UserMonthlyGoal[]     @relation("UserMonthlyGoals")
  monthlyActuals    UserMonthlyActual[]   @relation("UserMonthlyActuals")
  kpiGoals          UserKpiGoal[]         @relation("UserKpiGoals")
  kpiMonthlyEntries UserKpiMonthlyEntry[] @relation("UserKpiMonthlyEntries")

  eventsCreated    Event[]           @relation("EventCreatedBy")
  eventsVerified   Event[]           @relation("EventVerifiedBy")
  eventAttendances EventAttendance[] @relation("EventAttendances")
  caseManagedLeads Lead[]            @relation("LeadCaseManagerUser")

  policiesAsEmployee Policy[] @relation("PolicyEmployee")

  googleSheetsBackupConnections GoogleSheetsBackup[] @relation("GoogleSheetsBackupConnectedBy")

  @@index([teamId])
  @@index([deletedAt])
}

/// Logboek van belangrijke beheersacties, enkel zichtbaar voor de Beheerder.
model AuditLog {
  id          String   @id @default(cuid())
  /// Machine-leesbare actie, bv. "lead.deleted", "user.role_changed"
  action      String
  entityType  String
  entityId    String
  description String
  actorId     String
  actor       User     @relation("AuditActor", fields: [actorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

/// Eén rij per "sessie" van effectieve activiteit in de CRM (elk
/// scherm-bezoek, niet enkel het moment van inloggen) — zie
/// touchLoginActivity in sessions.ts, aangeroepen vanuit de layout bij elke
/// paginanavigatie. `createdAt` is het begin van de sessie, `lastSeenAt`
/// het laatste bezoek erbinnen; na 30 minuten zonder activiteit start een
/// nieuwe sessie i.p.v. de bestaande bij te werken. Voor Beheerder/Admin om
/// te zien wanneer iedereen actief was (zie /beheer/login-sessies).
model LoginEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("UserLoginEvents", fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Een duplicaten-groep (zie duplicates.ts) die een Beheerder/Admin bewust
/// als "geen probleem" gemarkeerd heeft — verdwijnt dan uit de Dubbele
/// leads-lijst tot de samenstelling van de groep verandert (bv. een nieuwe
/// lead met dezelfde contactgegevens komt erbij, waardoor de signature
/// wijzigt en de groep opnieuw beoordeeld moet worden).
model DismissedDuplicateGroup {
  id String @id @default(cuid())

  /// De betrokken lead-id's, alfabetisch gesorteerd en met "," samengevoegd.
  signature String @unique

  dismissedById String
  dismissedBy   User     @relation("DuplicateGroupDismissedBy", fields: [dismissedById], references: [id])
  dismissedAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Leads & funnels
// ---------------------------------------------------------------------------

/// De twee productlijnen/funnels die momenteel bestaan.
/// FA = Financiële Analyse / Financieel Advies
/// RG = Rechtsbijstand/Groep
enum LeadType {
  FA
  RG
}

enum LeadStatus {
  OPEN
  WON
  LOST
}

enum TaxDeclarationStatus {
  DONE
  TODO
  SCHEDULED
  NVT
  BOEKHOUDER
}

/// Configureerbare kolommen van de funnel-boards, per leadtype.
model FunnelStage {
  id        String   @id @default(cuid())
  leadType  LeadType
  key       String
  label     String
  order     Int
  color     String   @default("#64748b")
  isWon     Boolean  @default(false)
  isLost    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads            Lead[]
  stageChangesFrom LeadStageChange[] @relation("FromStage")
  stageChangesTo   LeadStageChange[] @relation("ToStage")

  @@unique([leadType, key])
  @@index([leadType, order])
}

model Lead {
  id              String     @id @default(cuid())
  firstName       String
  lastName        String
  email           String?
  phone           String?
  company         String?
  leadType        LeadType
  status          LeadStatus @default(OPEN)
  source          String?
  notes           String?
  value           Decimal?   @db.Decimal(10, 2)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  lastContactedAt DateTime?

  stageId String
  stage   FunnelStage @relation(fields: [stageId], references: [id])

  /// De verantwoordelijke medewerker (bepaalt zichtbaarheid via rollen)
  ownerId String
  owner   User   @relation("LeadOwner", fields: [ownerId], references: [id])

  createdById String
  createdBy   User   @relation("LeadCreatedBy", fields: [createdById], references: [id])

  /// Soft delete: verwijderde leads komen in de prullenbak i.p.v. definitief weg te zijn.
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("LeadDeletedBy", fields: [deletedById], references: [id])

  /// Dossierbeheerder van deze klant: standaard de medewerker die de lead via
  /// de funnel klant maakte, maar hier eventueel te vervangen door een
  /// subagent. Er is telkens maar één van beide ingevuld.
  caseManagerUserId     String?
  caseManagerUser       User?     @relation("LeadCaseManagerUser", fields: [caseManagerUserId], references: [id])
  caseManagerSubagentId String?
  caseManagerSubagent   Subagent? @relation("LeadCaseManagerSubagent", fields: [caseManagerSubagentId], references: [id])

  /// Status van de belastingsaangifte voor deze klant (enkel relevant voor klanten).
  taxDeclarationStatus TaxDeclarationStatus?

  /// Status van de opvolging van deze klant op "Klanten onder beheer" (los van belastingsaangifte).
  followUpStatus TaxDeclarationStatus?

  /// Pipeline: handmatig cijfer op 10 voor de inschatting van deze lead.
  qualityScore    Int?
  /// Pipeline: handmatig aan te vinken of de lead al op de hoogte is (bv. van de aanbeveling).
  isInformed      Boolean @default(false)
  /// Pipeline: handmatig aan te vinken of er al een bericht (bv. sms/mail) naar de lead verstuurd is.
  messageSent     Boolean @default(false)
  /// Pipeline recrutering: vrij in te vullen kenmerken van de kandidaat.
  characteristics String?

  activities   Activity[]
  stageChanges LeadStageChange[]
  products     LeadProduct[]
  policies     Policy[]

  @@index([ownerId])
  @@index([leadType, stageId])
  @@index([deletedAt])
  @@index([deletedAt, ownerId])
  @@index([deletedAt, status])
  @@index([caseManagerUserId])
  @@index([caseManagerSubagentId])
}

/// De financiële producten die Ceuppens Consulting aanbiedt, gekoppeld aan een klant.
enum ProductType {
  PENSIOENSPAREN
  LANGETERMIJNSPAREN
  BELEGGEN
  NZP
  UZP
  VAPZ
  IPT
  KINDERSPAREN
}

/// Eén product/contract dat een klant genomen heeft (bedrag + aantal eenheden).
/// De "basis"-producten (isFollowUp false, één per type) worden ingevuld bij
/// het rapporteren wanneer een lead klant wordt en beheerd via de
/// Producten-kaart (saveLeadProductsAction). Vervolgcontracten die later
/// uit opvolging komen (isFollowUp true, meerdere per type mogelijk) worden
/// apart toegevoegd via "Contracten uit opvolging". Gebruikt voor het
/// klantenoverzicht en voor de "aantal eenheden"-categorie bij incentives.
model LeadProduct {
  id        String      @id @default(cuid())
  leadId    String
  lead      Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      ProductType
  amount    Decimal     @db.Decimal(10, 2)
  units     Int         @default(0)
  /// Datum van dit contract — bepaalt in welke productiemaand het meetelt
  /// (zie production.ts/analytics.ts/incentives.ts), los van `createdAt`
  /// (wanneer het record zelf aangemaakt werd). Voor een basisproduct
  /// standaard het moment dat de klant klant werd; voor een vervolgcontract
  /// vrij in te vullen (standaard vandaag).
  contractDate DateTime  @default(now())
  /// true = vervolgcontract uit opvolging (los van de vaste productenlijst
  /// per type op de Producten-kaart); false = basisproduct.
  isFollowUp Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  /// Elk apart product/contract krijgt automatisch zijn eigen polis-lijn
  /// (zie Policy) zodra het toegevoegd wordt.
  policy Policy?

  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Polissen: het opvolg-tabblad bij Klanten, één lijn per product/contract
// ---------------------------------------------------------------------------

enum InsuranceCompany {
  VIVIUM
  AXA
  DELA
  CREDIMO
  ALLIANZ
}

enum PolicyStatus {
  OPGELADEN_WACHT_ACTIEF
  ACTIEF
  UITBETAALD
  GEANNULEERD
  BACKOFFICE
  POLIS_NOG_TEKENEN
  PROBLEEM_DOCUMENTEN
  POLIS_NOG_OPMAKEN
  AFWACHTEND_EERSTE_PREMIE
}

/// Eén lijn per apart product/contract (LeadProduct) van een klant — wordt
/// automatisch aangemaakt zodra dat product toegevoegd wordt (zie
/// saveLeadProductsAction). Datum/klant/product/eenheden komen rechtstreeks
/// van de lead/het product; de rest (medewerker, maatschappij, status,
/// documentenchecklist, ingangs-/betaaldatum) wordt hier zelf ingevuld en
/// bijgehouden, los van de rest van de leaddata.
model Policy {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  leadProductId String      @unique
  leadProduct   LeadProduct @relation(fields: [leadProductId], references: [id], onDelete: Cascade)

  /// De medewerker die de klant heeft aangebracht; standaard de eigenaar van
  /// de lead op het moment dat de polis-lijn ontstaat, maar hier te wijzigen.
  employeeId String
  employee   User   @relation("PolicyEmployee", fields: [employeeId], references: [id])

  company InsuranceCompany?
  status  PolicyStatus      @default(OPGELADEN_WACHT_ACTIEF)

  /// Documentenchecklist, telkens gewoon aan-/uitvinken.
  easy   Boolean @default(false)
  tool   Boolean @default(false)
  rl     Boolean @default(false)
  saFile Boolean @default(false)
  ccFile Boolean @default(false)

  ingangsdatum DateTime?
  betaaldOp    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([employeeId])
  @@index([status])
}

model LeadStageChange {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  fromStageId String?
  fromStage   FunnelStage? @relation("FromStage", fields: [fromStageId], references: [id])

  toStageId String
  toStage   FunnelStage @relation("ToStage", fields: [toStageId], references: [id])

  changedById String
  changedBy   User   @relation("StageChangedBy", fields: [changedById], references: [id])

  changedAt DateTime @default(now())

  @@index([changedAt])
  @@index([leadId])
  @@index([toStageId])
  @@index([changedById])
}

// ---------------------------------------------------------------------------
// Opvolging: activiteiten & ingeplande gesprekken
// ---------------------------------------------------------------------------

enum ActivityType {
  CALL
  MEETING
  EMAIL
  NOTE
}

enum ActivityStatus {
  PLANNED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum MeetingMode {
  ONSITE
  ONLINE
}

model Activity {
  id              String         @id @default(cuid())
  type            ActivityType
  status          ActivityStatus @default(PLANNED)
  subject         String
  notes           String?
  scheduledAt     DateTime?
  durationMinutes Int?           @default(15)
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  /// Enkel relevant bij een afgerond CALL: kwam je voicemail uit i.p.v. de lead te bereiken?
  wasVoicemail Boolean @default(false)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  assigneeId String
  assignee   User   @relation("ActivityAssignee", fields: [assigneeId], references: [id])

  // Koppeling met het Google Calendar event zodat we het later kunnen
  // updaten/verwijderen wanneer de activiteit verandert.
  googleEventId    String?
  googleCalendarId String?
  googleSyncError  String?

  // Planning-widget: locatie/online-gegevens voor een ingeplande afspraak
  // (Financiële analyse/Adviesgesprek e.d.), meegenomen in het Google
  // Agenda-item als locatie/omschrijving/Meet-koppeling.
  meetingMode MeetingMode?
  location    String?
  meetingLink String?

  /// Subagent die mee uitgenodigd wordt (bv. bij een Adviesgesprek, om te closen).
  subagentId String?
  subagent   Subagent? @relation("ActivitySubagent", fields: [subagentId], references: [id])

  @@index([leadId])
  @@index([assigneeId])
  @@index([scheduledAt])
  @@index([assigneeId, status])
  @@index([status, scheduledAt])
}

// ---------------------------------------------------------------------------
// Incentives: motivatie-events met een doel, poster en ranglijst
// ---------------------------------------------------------------------------

/// Op welke meting een categorie of top-N-ranglijst gebaseerd is.
enum IncentiveMetric {
  /// Aantal leads dat een gebruiker heeft gewonnen (klanten) binnen de looptijd
  CLIENTS_WON
  /// Som van het aantal eenheden van gewonnen leads binnen de looptijd
  UNITS
  /// Aantal afgeronde RG-gesprekken binnen de looptijd
  RG_MEETINGS
  /// Aantal afgeronde contactmomenten/activiteiten binnen de looptijd
  ACTIVITIES_COMPLETED
}

/// Hoe winnaars bepaald worden: op richtcijfers per categorie, of gewoon top-N.
enum IncentiveMode {
  /// Elke categorie heeft een richtcijfer (bv. min 5 klanten); wie alle richtcijfers haalt wint
  THRESHOLD
  /// Geen richtcijfer: de top N op de ranglijst wint
  TOP_N
}

model Incentive {
  id          String        @id @default(cuid())
  title       String
  /// De regels/vereisten om te winnen, vrije tekst
  description String
  mode        IncentiveMode @default(THRESHOLD)

  /// Enkel bij mode = TOP_N: op welke meting wordt gerangschikt
  rankingMetric   IncentiveMetric?
  /// Enkel bij mode = TOP_N: optioneel enkel leads van dit type meetellen
  rankingLeadType LeadType?
  /// Enkel bij mode = TOP_N: hoeveel plaatsen winnen (top 1 t.e.m. top 10)
  topN            Int?

  startDate DateTime
  endDate   DateTime

  // De poster (jpeg of pdf) wordt als binaire data in de database bewaard,
  // zodat er geen aparte bestandsopslag nodig is.
  posterData     Bytes?
  posterMimeType String?
  posterFilename String?

  createdById String
  createdBy   User     @relation("IncentiveCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories IncentiveCategory[]

  @@index([startDate, endDate])
}

/// Enkel bij mode = THRESHOLD: één rij per categorie met een eigen richtcijfer
/// (bv. "min 5 klanten", "min 800 eenheden", "min 1 RG-gesprek").
model IncentiveCategory {
  id          String          @id @default(cuid())
  incentiveId String
  incentive   Incentive       @relation(fields: [incentiveId], references: [id], onDelete: Cascade)
  metric      IncentiveMetric
  /// Optioneel: enkel leads van dit type meetellen voor deze categorie (null = FA + RG samen)
  leadType    LeadType?
  targetValue Int
  order       Int             @default(0)

  @@index([incentiveId])
}

// ---------------------------------------------------------------------------
// Doelen / KPI's per gebruiker (dashboard-management)
// ---------------------------------------------------------------------------

/// De wekelijkse doelen bovenaan het dashboard.
enum GoalMetric {
  UNITS
  CUSTOMERS
  CONVERSATIONS
  ABV_SALES
  ABV_RG
}

/// Eén wekelijks doel per gebruiker per metric, ingesteld door een Beheerder/Admin.
/// Het `target` geldt vanaf het moment van instellen (geen historiek per week).
model UserGoal {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation("UserGoals", fields: [userId], references: [id], onDelete: Cascade)
  metric    GoalMetric
  target    Decimal    @db.Decimal(12, 2)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, metric])
}

/// Eén rij per (jaar, productiemaand 1-12) met de effectieve begin-/
/// einddatum van die productiemaand — hoeft niet gelijk te lopen met de
/// kalendermaand. `endDate` is inclusief (einde van de dag), net als
/// GoalPeriod. Nog niet ingesteld voor een maand = valt terug op de
/// kalendermaand.
model ProductionMonth {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  startDate DateTime
  endDate   DateTime
  updatedAt DateTime @updatedAt

  @@unique([year, month])
}

/// Doel per gebruiker, per metric (Klanten/Eenheden), per productiemaand —
/// los van het wekelijkse UserGoal hierboven.
model UserMonthlyGoal {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation("UserMonthlyGoals", fields: [userId], references: [id], onDelete: Cascade)
  metric    GoalMetric
  year      Int
  month     Int
  target    Decimal    @db.Decimal(12, 2)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, metric, year, month])
  @@index([userId, metric, year])
}

/// Handmatige correctie op het automatisch berekende "Behaald" (Klanten/
/// Eenheden) per gebruiker, per productiemaand — enkel bedoeld om data van
/// vóór het gebruik van dit CRM alsnog in te voeren. Als hier een rij bestaat
/// voor een (gebruiker, metric, jaar, maand), overschrijft die waarde het
/// automatisch berekende cijfer op de Productie-tab/het dashboard.
model UserMonthlyActual {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation("UserMonthlyActuals", fields: [userId], references: [id], onDelete: Cascade)
  metric    GoalMetric
  year      Int
  month     Int
  value     Decimal    @db.Decimal(12, 2)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, metric, year, month])
  @@index([userId, metric, year])
}

/// De 4 jaarlijkse KPI's onder "Productie jaarlijks".
enum KpiMetric {
  CONVERSATIONS
  PRODUCTION
  CALLING_SESSION
  SEMINAR
}

/// Jaarlijks doel per gebruiker per KPI (per jaar apart in te stellen).
model UserKpiGoal {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("UserKpiGoals", fields: [userId], references: [id], onDelete: Cascade)
  metric    KpiMetric
  year      Int
  target    Decimal   @db.Decimal(12, 2)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, metric, year])
}

/// Manueel ingevoerde maandstand per KPI; de som van de 12 maanden vormt het jaarcijfer.
model UserKpiMonthlyEntry {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("UserKpiMonthlyEntries", fields: [userId], references: [id], onDelete: Cascade)
  metric    KpiMetric
  year      Int
  /// 1 (januari) t.e.m. 12 (december)
  month     Int
  value     Decimal   @db.Decimal(12, 2)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, metric, year, month])
  @@index([userId, metric, year])
}

// ---------------------------------------------------------------------------
// Evenementen: vergaderingen & seminaries met aanwezigheidsregistratie
// ---------------------------------------------------------------------------

enum EventType {
  MEETING
  SEMINAR
  BELSESSIE
  MANAGEMENTMEETING
  STRUCTUURMEETING
}

enum AttendanceStatus {
  PENDING
  GOING
  NOT_GOING
}

model Event {
  id          String    @id @default(cuid())
  title       String
  type        EventType
  date        DateTime
  endDate     DateTime?
  location    String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdById String
  createdBy   User   @relation("EventCreatedBy", fields: [createdById], references: [id])

  /// Voor seminaries: pas na bevestiging door een Beheerder/Admin telt de
  /// aanwezigheid mee voor KPI Seminarie van de werknemers.
  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?     @relation("EventVerifiedBy", fields: [verifiedById], references: [id])

  attendances EventAttendance[]

  @@index([type, date])
}

/// Of een gebruiker aanwezig zal zijn op een evenement (RSVP vooraf), en de
/// nadien door een Beheerder/Admin bevestigde effectieve aanwezigheid.
/// Enkel `actualStatus` (na verificatie) telt mee voor KPI Seminarie.
model EventAttendance {
  id           String            @id @default(cuid())
  eventId      String
  event        Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       String
  user         User              @relation("EventAttendances", fields: [userId], references: [id], onDelete: Cascade)
  status       AttendanceStatus  @default(PENDING)
  actualStatus AttendanceStatus?
  updatedAt    DateTime          @updatedAt

  @@unique([eventId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Automatische back-up naar Google Sheets
// ---------------------------------------------------------------------------

/// Eén globale koppeling (niet per gebruiker) waarmee een volledige back-up
/// van alle CRM-data automatisch naar één Google Sheets-bestand geschreven
/// wordt. Een Beheerder koppelt eenmalig zijn Google-account; de scheduled
/// sync (cron) en de "Nu synchroniseren"-knop gebruiken daarna deze ene
/// refresh token, ongeacht wie er op dat moment ingelogd is.
model GoogleSheetsBackup {
  id     String  @id @default(cuid())
  active Boolean @default(true)

  connectedByUserId String
  connectedByUser   User   @relation("GoogleSheetsBackupConnectedBy", fields: [connectedByUserId], references: [id])
  connectedEmail    String
  refreshToken      String

  /// Het ene Google Sheets-bestand dat hergebruikt wordt bij elke sync
  /// (aangemaakt bij de eerste synchronisatie). `null` tot de eerste sync.
  spreadsheetId String?

  lastSyncedAt  DateTime?
  lastSyncError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
